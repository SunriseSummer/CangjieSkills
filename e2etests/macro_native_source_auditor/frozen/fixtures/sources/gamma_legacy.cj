package sample.gamma

public class GammaStore {
    public var alpha: Int64 = 1
    public var beta: Int64 = 2
    public var gamma: Int64 = 3

    public func first(): Int64 {
        return alpha
    }

    public func second(): Int64 {
        return beta
    }

    public func third(): Int64 {
        return gamma
    }
}
